NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DATABASE_MIGRATION_URL=
RESEND_API_KEY=
EMAIL_FROM=
UNSUBSCRIBE_SECRET=
# LLM provider for the bot (D213): anthropic (default) or openrouter.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# OpenRouter: free models (…:free) need no price; set LLM_MODEL_CHAT to one or leave it empty.
OPENROUTER_API_KEY=
LLM_MODEL_CHAT=claude-sonnet-5-5
LLM_MODEL_EXTRACT=claude-haiku-4-5-20251001
LLM_DAILY_BUDGET_USD=20
# 7A (D171): micro-USD per 1M tokens for each model in use, e.g.
# {"claude-sonnet-5-5":{"in":<input price>,"out":<output price>}}.
# Without a price for LLM_MODEL_CHAT the bot stays off.
LLM_PRICES_MICRO_USD=
EMBEDDINGS_ENABLED=false
IMPORT_LIVE_ENABLED=false
CRON_SECRET=
PRIVACY_HASH_SECRET=
# When 1, /admin on the public host is 404. Leave unset until the admin host is checked (D251).
ADMIN_HOST_ONLY=
SENTRY_DSN=
# Telegram sign-in (D217): token from @BotFather; the bot domain must be set with /setdomain.
TELEGRAM_BOT_TOKEN=
# IndexNow: tells Bing and Yandex about new jobs at once (D284). Any
# 8-128 character key of letters, digits and dashes; empty disables the ping.
INDEXNOW_KEY=
# Site ownership proofs (D298). Paste the token each tool gives you; an empty
# value simply leaves the meta tag out. Google Search Console, Yandex
# Webmaster, Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
# The site may be opened as a Telegram Mini App (D259). Turn on only after the
# Mini App is set up in BotFather: it lets Telegram Web frame the site.
TELEGRAM_MINI_APP_ENABLED=
